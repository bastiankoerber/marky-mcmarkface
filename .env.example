# Copy to `.env` if you are running a fork with its own GitHub app registration. Most people
# never touch this file — the in-app setup screen writes ~/.marky-mcmarkface/oauth.json instead, and the
# GitHub CLI button needs none of this.
#
# Real environment variables take precedence over anything set here.
#
# Register once at:
#   https://github.com/settings/applications/new
#     ?oauth_application[name]=Marky McMarkface
#     &oauth_application[url]=https://github.com/bastiankoerber/marky-mcmarkface
#     &oauth_application[callback_url]=http://127.0.0.1/callback
#
# Register the callback WITHOUT a port. GitHub's loopback rule lets the redirect_uri use any
# port, so one registration covers whichever port Marky McMarkface binds.

# Required only for the browser sign-in flows (PKCE and device code). The GitHub CLI button and
# the paste-a-token path work without it. Not a secret — this is what ships in the repo.
MARKY_MCMARKFACE_GITHUB_CLIENT_ID=

# Optional. With it, sign-in is one click and no codes (authorization code + PKCE).
# Without it, Marky McMarkface uses device flow, which needs no secret at all.
MARKY_MCMARKFACE_GITHUB_CLIENT_SECRET=

# Optional overrides.
# MARKY_MCMARKFACE_PORT=7423
# MARKY_MCMARKFACE_VITE_ORIGIN=http://localhost:5180
