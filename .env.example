# Pilcrow reads these only if it needs to. Copy to `.env` if you are running a fork with its
# own GitHub app registration; most people never touch this file.
#
# Register once at:
#   https://github.com/settings/applications/new
#     ?oauth_application[name]=Pilcrow
#     &oauth_application[url]=https://github.com/pilcrow-md/pilcrow
#     &oauth_application[callback_url]=http://127.0.0.1/callback
#
# Register the callback WITHOUT a port. GitHub's loopback rule lets the redirect_uri use any
# port, so one registration covers whichever port Pilcrow binds.

# Required for any GitHub sign-in. Not a secret — this is what ships in the repo.
PILCROW_GITHUB_CLIENT_ID=

# Optional. With it, sign-in is one click and no codes (authorization code + PKCE).
# Without it, Pilcrow uses device flow, which needs no secret at all.
PILCROW_GITHUB_CLIENT_SECRET=

# Optional overrides.
# PILCROW_PORT=7423
# PILCROW_VITE_ORIGIN=http://localhost:5180
