{
  "name": "marky-mcmarkface",
  "private": true,
  "license": "MIT",
  "author": "Bastian Körber",
  "repository": "github:bastiankoerber/marky-mcmarkface",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "spike:anchoring": "tsx packages/viewers/markdown/spike/run.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm -C packages/host build",
    "desktop:build": "pnpm build && pnpm -C packages/desktop build",
    "desktop:run": "pnpm desktop:build && pnpm -C packages/desktop runtime:install && pnpm -C packages/desktop start",
    "desktop:package": "pnpm desktop:build && pnpm -C packages/desktop package",
    "desktop:make": "pnpm desktop:build && pnpm -C packages/desktop make",
    "notices": "node scripts/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss>nanoid": "3.3.17",
      "@electron/rebuild>tar": "7.5.21",
      "@electron/node-gyp>tar": "7.5.21",
      "cacache>tar": "7.5.21",
      "external-editor>tmp": "0.2.7",
      "nanoid@<3.3.17": "3.3.17"
    },
    "onlyBuiltDependencies": [
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
